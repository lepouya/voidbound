{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "voidbound",
  "version": "0.1.0",
  "identifier": "com.voidbound.app",
  "build": {
    "beforeDevCommand": "deno task dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "deno task build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "voidbound",
        "width": 390,
        "height": 844
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "cli": {
      "args": [
        {
          "name": "player",
          "takesValue": true
        },
        {
          "name": "time-scale",
          "takesValue": true
        },
        {
          "name": "restore-backup",
          "takesValue": true
        },
        {
          "name": "reset-player",
          "takesValue": true
        },
        {
          "name": "reset-system"
        },
        {
          "name": "list-players"
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
