{
  "tasks": {
    "format": "deno task format:ts && deno task format:rs",
    "format:ts": "deno fmt",
    "format:rs": "cd src-tauri && cargo fmt",
    "check": "deno task check:ts && deno task check:rs",
    "check:ts": "deno check src/**/*.ts tests/*.ts",
    "check:rs": "cd src-tauri && cargo check",
    "lint": "deno task lint:ts && deno task lint:rs",
    "lint:ts": "deno lint",
    "lint:rs": "cd src-tauri && cargo clippy",
    "test": "deno task test:ts && deno task test:rs",
    "test:ts": "deno test --allow-read tests/",
    "test:rs": "cd src-tauri && cargo test"
  },
  "fmt": {
    "exclude": ["src/assets/"]
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "@std/path": "jsr:@std/path@1"
  }
}
